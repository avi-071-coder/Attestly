# ForgeAI Backend Environment Configuration
# Copy this to .env and fill in your values

# ─── Application ──────────────────────────────────
APP_NAME=ForgeAI
DEBUG=true

# ─── Database ─────────────────────────────────────
# SQLite for local dev:
DATABASE_URL=sqlite+aiosqlite:///./forgeai.db
# PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/forgeai

# ─── Auth ─────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Redis ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── MinIO ────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ─── Hugging Face ─────────────────────────────────
# Required for gated models (Llama, Gemma, etc.)
HF_TOKEN=

# ─── Model Serving ────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8001
DEFAULT_SERVING_BACKEND=ollama

# ─── CORS ─────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
